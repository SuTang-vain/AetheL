# BabeL-O AI Engine（唯一 AI 引擎）
# 所有 LLM 调用经 BabeL-O 的 OpenAI 兼容网关（POST /v1/chat/completions）；
# 模型与密钥由 BabeL-O 统一管理（ADR-B2），AetheL 不维护任何托管服务商配置。
# 启动 BabeL-O（端口 3100，默认 3000 与 AetheL Express 冲突）：
#   cd BabeL-O && NEXUS_PORT=3100 npm start
BABEL_NEXUS_URL=http://127.0.0.1:3100
# 可选：BabeL-O daemon 配置了 NEXUS_API_KEY 时填写，否则留空
BABEL_NEXUS_API_KEY=

# API Server Port
PORT=3000
