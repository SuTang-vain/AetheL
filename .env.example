# AI Service Providers API Keys
MODELSCOPE_API_KEY=your_api_key_here
DEEPSEEK_API_KEY=your_api_key_here
MOONSHOT_API_KEY=your_api_key_here

# Current AI Provider (moonshot | deepseek | modelscope)
# If omitted, the backend picks the first configured API key in this order:
# modelscope -> deepseek -> moonshot.
AI_PROVIDER=modelscope

# API Server Port
PORT=3000

# LinkMind（链藏）外部证据服务
# LinkMind 默认端口是 3000，与 AetheL Express 冲突，约定用 3100 启动：
#   cd workflow && npm run dev -- -p 3100
LINKMIND_BASE_URL=http://localhost:3100
LINKMIND_IMPORT_POLL_INTERVAL_MS=2000
LINKMIND_IMPORT_POLL_TIMEOUT_MS=120000
LINKMIND_PROXY_TIMEOUT_MS=15000

