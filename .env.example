# AI Service Providers API Keys
MODELSCOPE_API_KEY=your_api_key_here
DEEPSEEK_API_KEY=your_api_key_here
MOONSHOT_API_KEY=your_api_key_here

# Current AI Provider (babel | moonshot | deepseek | modelscope)
# If omitted, the backend picks the first configured provider in this order:
# babel -> modelscope -> deepseek -> moonshot.
AI_PROVIDER=modelscope

# BabeL-O AI Engine (optional). When set, the 'babel' provider is available:
# all LLM calls go through BabeL-O's OpenAI-compatible gateway
# (POST /v1/chat/completions); model selection stays in BabeL-O config.
# Run BabeL-O on port 3100 (default 3000 conflicts with AetheL Express):
#   cd BabeL-O && NEXUS_PORT=3100 npm start
BABEL_NEXUS_URL=http://127.0.0.1:3100
# 可选：BabeL-O daemon 配置了 NEXUS_API_KEY 时填写，否则留空
BABEL_NEXUS_API_KEY=

# API Server Port
PORT=3000
